# Copy to .env and fill in. Never commit .env.
#
# AI provider. Groq has a free tier and needs no card: https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=

# Optional: use OpenAI instead.
# AI_PROVIDER=openai
# OPENAI_API_KEY=

# Override the model if you want a different one.
# AI_MODEL=llama-3.3-70b-versatile

# MongoDB. Omit entirely to run on the in-memory catalogue.
MONGODB_URL=mongodb://localhost:27017

# Comma-separated production origins allowed by CORS.
ALLOWED_ORIGINS=
